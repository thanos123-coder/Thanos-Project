{
  "name": "ai-college-counselor-agents",
  "version": "0.1.0",
  "description": "Specialist agents 01-09 of the AI College Counselor: orchestration, intake, documents, student record, exploration, eligibility, planning, activities and opportunity research.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "demo": "tsc -p tsconfig.examples.json && node .demo-build/examples/demo.js",
    "mutation": "node scripts/mutation-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "decimal.js": "^10.6.0",
    "luxon": "^3.7.2",
    "pdfjs-dist": "^6.3.289",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.20.4",
    "pdf-lib": "^1.17.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
